{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question-batch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "stage",
    "base_revision",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5",
        "S6",
        "S7",
        "S8"
      ]
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt",
          "selection_mode",
          "target_paths"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "concept": {
            "type": "string"
          },
          "selection_mode": {
            "enum": [
              "single",
              "multiple",
              "text"
            ]
          },
          "target_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "allow_custom_answer": {
            "type": "boolean"
          },
          "free_text_placeholder": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "concept": {
                  "type": "string"
                },
                "updates": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
