{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "batch_id",
    "base_revision",
    "stage",
    "questions"
  ],
  "properties": {
    "batch_id": {
      "type": "string"
    },
    "base_revision": {
      "type": "integer"
    },
    "stage": {
      "pattern": "^I[0-8]$"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt",
          "type",
          "options",
          "allow_custom"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "type": {
            "enum": [
              "single_select",
              "multi_select",
              "text"
            ]
          },
          "options": {
            "type": "array"
          },
          "allow_custom": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
